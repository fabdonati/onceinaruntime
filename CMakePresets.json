{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug correctness",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_COMPILER": "g++-16",
        "OIR_BARRIER_SIMD": "ON",
        "OIR_BARRIER_PRECISION": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "displayName": "Optimized measurements",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitize",
      "inherits": "debug",
      "displayName": "Debug with ASan and UBSan",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "MEASURED_SANITIZERS": "ON"
      }
    },
    {
      "name": "barrier-debug",
      "inherits": "debug",
      "displayName": "barrier-debug",
      "binaryDir": "${sourceDir}/build/barrier-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16",
        "OIR_BARRIER_SIMD": "ON",
        "OIR_BARRIER_PRECISION": "OFF"
      }
    },
    {
      "name": "barrier-release",
      "inherits": "release",
      "displayName": "barrier-release",
      "binaryDir": "${sourceDir}/build/barrier-release",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16",
        "OIR_BARRIER_SIMD": "ON",
        "OIR_BARRIER_PRECISION": "OFF"
      }
    },
    {
      "name": "barrier-sanitize",
      "inherits": "sanitize",
      "displayName": "barrier-sanitize",
      "binaryDir": "${sourceDir}/build/barrier-sanitize",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16",
        "OIR_BARRIER_SIMD": "ON",
        "OIR_BARRIER_PRECISION": "OFF"
      }
    },
    {
      "name": "precision-debug",
      "inherits": "barrier-debug",
      "binaryDir": "${sourceDir}/build/precision-debug",
      "cacheVariables": {
        "OIR_BARRIER_PRECISION": "ON"
      }
    },
    {
      "name": "precision-sanitize",
      "inherits": "barrier-sanitize",
      "binaryDir": "${sourceDir}/build/precision-sanitize",
      "cacheVariables": {
        "OIR_BARRIER_PRECISION": "ON"
      }
    },
    {
      "name": "precision-release",
      "inherits": "barrier-release",
      "binaryDir": "${sourceDir}/build/precision-release",
      "cacheVariables": {
        "OIR_BARRIER_PRECISION": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "barrier-debug",
      "configurePreset": "barrier-debug"
    },
    {
      "name": "barrier-release",
      "configurePreset": "barrier-release"
    },
    {
      "name": "barrier-sanitize",
      "configurePreset": "barrier-sanitize"
    },
    {
      "name": "precision-debug",
      "configurePreset": "precision-debug"
    },
    {
      "name": "precision-sanitize",
      "configurePreset": "precision-sanitize"
    },
    {
      "name": "precision-release",
      "configurePreset": "precision-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "barrier-debug",
      "configurePreset": "barrier-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "barrier-release",
      "configurePreset": "barrier-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "barrier-sanitize",
      "configurePreset": "barrier-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "precision-debug",
      "configurePreset": "precision-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "precision-sanitize",
      "configurePreset": "precision-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "precision-release",
      "configurePreset": "precision-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
